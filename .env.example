# Environment configuration of the dashboard. deploy/install.sh writes the real .env (never committed).

APP_ENV=production
APP_DEBUG=false
# Public address without a trailing slash (used for the administrator setup link)
APP_URL=https://rollout.example.com
# 32-byte master key: php bin/console key:generate. NEVER change or lose it (all passwords depend on it).
APP_KEY=
APP_TIMEZONE=Asia/Jakarta

# mysql (production) or sqlite (local development; file storage/database/rollout.sqlite)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Runner service on this server (same secret as /etc/arsika-rollout-manager/runner.json)
RUNNER_URL=http://127.0.0.1:8790
RUNNER_SECRET=
